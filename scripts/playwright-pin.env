# The Playwright that scripts/screenshot-pages.sh and scripts/check-grants-live.py
# run, read by scripts/playwright-run.sh: the only place that names the version.
# 1.64.0 ships the Chromium headless shell build 1248. EXCLUDE_NEWER makes uv
# resolve playwright and its dependencies as of that date (RFC 3339), so a run
# does not pick up a release newer than 7 days at the time it was set.
#
# To update: pick a release at least 7 days old, set VERSION, and set
# EXCLUDE_NEWER to a date at least 7 days in the past and after that release.
PLAYWRIGHT_VERSION=1.64.0
PLAYWRIGHT_EXCLUDE_NEWER=2026-11-01T00:00:00Z
