# The OpenSSL release that warden-server and warden-demo link, built from source by
# scripts/build-openssl.sh. No registry tracks this file, so
# .github/scripts/openssl_support.py checks it against the end-of-support date and,
# every night, against the newest release of the line.
#
# To update: take the hash from the release's .sha256 file, after checking the tarball
# against its .asc signature, and keep SUPPORT_ENDS in step with
# https://openssl-library.org/policies/releasestrat/ . OpenSSL publishes this signing
# certificate's primary key fingerprint as the trust anchor for its releases:
#   B146 647E 45A7 B339 47AB  226B 2A2C 87D1 6169 2D40
# and 3.5.9 is signed by its subkey:
#   C46E D3F2 CBEF DA1F DAAD  A442 64ED 7B1D CCE7 1CB2
WARDEN_OPENSSL_VERSION=3.5.9
WARDEN_OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
WARDEN_OPENSSL_SUPPORT_ENDS=2030-04-08
